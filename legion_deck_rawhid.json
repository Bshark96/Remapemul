  "analogSticks": {
    "formatA": {
      "leftStickX": { "byte": 12, "center": 128, "formula": "(int(B12) - 128) * 256" },
      "leftStickY": { "byte": 13, "center": 128, "formula": "(128 - int(B13)) * 256" },
      "rightStickX": { "byte": 14, "center": 128, "formula": "(int(B14) - 128) * 256" },
      "rightStickY": { "byte": 15, "center": 128, "formula": "(128 - int(B15)) * 256" },
      "deadzone": 8
    },
    "formatB": {
      "leftStickX": { "byte": 14, "center": 128, "invert": false, "deadzone": 8 },
      "leftStickY": { "byte": 15, "center": 128, "invert": true, "deadzone": 8 },
      "rightStickX": { "byte": 16, "center": 128, "invert": false, "deadzone": 8 },
      "rightStickY": { "byte": 17, "center": 128, "invert": true, "deadzone": 8 }
    }
  },
  "analogTriggers": {
    "formatA": {
      "leftTrigger": { "byte": 20, "scaleTo32767": "int(B20) * 32767 // 255" },
      "rightTrigger": { "byte": 21, "scaleTo32767": "int(B21) * 32767 // 255" }
    },
    "formatB": {
      "leftTrigger": { "byte": 19, "scaleTo32767": "int(B19) * 32767 // 255" },
      "rightTrigger": { "byte": 20, "scaleTo32767": "int(B20) * 32767 // 255" }
    }
